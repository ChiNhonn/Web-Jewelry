<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP traffic specifically for local development & test hosts -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android Emulator Host Loopback -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Standard Localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Private LAN Subnets for Physical Devices on Wi-Fi -->
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
    </domain-config>

    <!-- Production Fallback: All remote public traffic MUST be HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
