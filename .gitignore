# Root .gitignore for Jewelry E-Commerce System

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend (Maven & Java)
backend/target/
backend/bin/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log
backend/*.log

# Frontend (Node & Vite)
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/dist-ssr/
*.local
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Environment secrets
*.env
*.env.dev
*.env.prod
